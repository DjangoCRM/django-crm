# Copy to .env and adjust for local development.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_DB_ENGINE=sqlite3
DJANGO_DB_NAME=crm_db

# Outbound mail (optional in DEBUG; required in production when any mail value is set)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=crm@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=test@example.com
# SERVER_EMAIL=test@example.com
# DJANGO_ADMINS=Admin1 <admin1_box@example.com>
# DJANGO_MANAGERS=Manager1 <manager1@example.com>

# CRM self-reference and Google OAuth2 (Gmail delegation)
# CRM_IP=127.0.0.1
# CRM_HOST=my_crm_host_name
# GOOGLE_OAUTH2_CLIENT_ID=
# GOOGLE_OAUTH2_CLIENT_SECRET=

# VoIP (Zadarma) — optional; leave unset to disable telephony integration
# ZADARMA_KEY=placeholder-zadarma-key
# ZADARMA_SECRET=placeholder-zadarma-secret
# ZADARMA_PROVIDER_ALLOWLIST=185.45.152.42
# VOIP_FORWARD_DATA=false
# VOIP_FORWARDING_IP=
# VOIP_FORWARD_URL=

# Google reCAPTCHA (public contact form)
# GOOGLE_RECAPTCHA_SITE_KEY=placeholder-recaptcha-site-key
# GOOGLE_RECAPTCHA_SECRET_KEY=placeholder-recaptcha-secret-key

# Obfuscated URL prefixes (defaults preserve existing test URLs)
# SECRET_CRM_PREFIX=123/
# SECRET_ADMIN_PREFIX=456-admin/
# SECRET_LOGIN_PREFIX=789-login/
