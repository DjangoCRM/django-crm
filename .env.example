# Django-CRM environment template
#
# Quick start:
#   cp .env.example .env
#   python manage.py generate_secret_key   # paste into DJANGO_SECRET_KEY
#   python manage.py show_config           # verify resolved values (secrets masked)
#
# Quoting rules:
# - Do not wrap values in quotes unless they contain spaces.
# - Hash (#) starts a comment only at the beginning of a line.
# - Values with spaces, equals signs, or commas may be wrapped in double quotes.
# - Windows users: save .env with Unix line endings when possible.
#
# Secret files alternative:
# - Set DJANGO_SECRETS_DIR (default: /run/secrets) and place one file per variable
#   using the lowercase variable name (for example django_secret_key).

# --- Core Django (mandatory: DJANGO_SECRET_KEY) ---

# Mandatory. Generate with: python manage.py generate_secret_key
DJANGO_SECRET_KEY=<your-django-secret-key>

# Optional. Default: false
DJANGO_DEBUG=<true-or-false>

# Optional. Default: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=<comma-separated-hostnames>

# Optional. Default: http://localhost,http://127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=<comma-separated-origins>

# Optional production hardening (defaults follow DJANGO_DEBUG when unset)
# DJANGO_SECURE_SSL_REDIRECT=<true-or-false>
# DJANGO_SESSION_COOKIE_SECURE=<true-or-false>
# DJANGO_CSRF_COOKIE_SECURE=<true-or-false>
# DJANGO_SECURE_HSTS_SECONDS=<seconds>

# --- Database (optional — SQLite default) ---

# Optional. Use either DATABASE_URL or discrete DJANGO_DB_* variables.
# DATABASE_URL=<database-url>
# DJANGO_DB_ENGINE=<sqlite3|postgresql|mysql>
# DJANGO_DB_NAME=<database-name>
# DJANGO_DB_USER=<database-user>
# DJANGO_DB_PASSWORD=<database-password>
# DJANGO_DB_HOST=<database-host>
# DJANGO_DB_PORT=<database-port>

# --- Outbound mail (optional in DEBUG; all required in production when any mail value is set) ---

# EMAIL_HOST=<smtp-hostname>
# EMAIL_PORT=<smtp-port>
# EMAIL_HOST_USER=<smtp-username>
# EMAIL_HOST_PASSWORD=<smtp-password>
# EMAIL_USE_TLS=<true-or-false>
# EMAIL_USE_SSL=<true-or-false>
# DEFAULT_FROM_EMAIL=<from-address>
# SERVER_EMAIL=<server-address>
# DJANGO_ADMINS=<Name <email>, Name2 <email2>>
# DJANGO_MANAGERS=<Name <email>, Name2 <email2>>

# --- CRM self-reference ---

# Optional. Defaults: 127.0.0.1 / my_crm_host_name
# CRM_IP=<crm-ip-address>
# CRM_HOST=<crm-hostname>

# --- Google OAuth2 (Gmail delegation; optional) ---

# GOOGLE_OAUTH2_CLIENT_ID=<oauth-client-id>
# GOOGLE_OAUTH2_CLIENT_SECRET=<oauth-client-secret>

# --- Google reCAPTCHA (optional) ---

# GOOGLE_RECAPTCHA_SITE_KEY=<recaptcha-site-key>
# GOOGLE_RECAPTCHA_SECRET_KEY=<recaptcha-secret-key>

# --- VoIP / Zadarma (optional; both key and secret required together) ---

# ZADARMA_KEY=<zadarma-api-key>
# ZADARMA_SECRET=<zadarma-api-secret>
# ZADARMA_PROVIDER_ALLOWLIST=<comma-separated-ip-addresses>
# VOIP_FORWARD_DATA=<true-or-false>
# VOIP_FORWARDING_IP=<forwarding-ip>
# VOIP_FORWARD_URL=<forwarding-url>

# --- Obfuscated URL prefixes (optional) ---

# SECRET_CRM_PREFIX=<crm-url-prefix>
# SECRET_ADMIN_PREFIX=<admin-url-prefix>
# SECRET_LOGIN_PREFIX=<login-url-prefix>

# --- Operational ---

# DJANGO_SECRETS_DIR=<path-to-secret-files-directory>
