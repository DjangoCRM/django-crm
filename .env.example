# Copy to .env and adjust for local development.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_DB_ENGINE=sqlite3
DJANGO_DB_NAME=crm_db

# Outbound mail (optional in DEBUG; required in production when any mail value is set)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=crm@example.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=test@example.com
# SERVER_EMAIL=test@example.com
# DJANGO_ADMINS=Admin1 <admin1_box@example.com>
# DJANGO_MANAGERS=Manager1 <manager1@example.com>

# CRM self-reference and Google OAuth2 (Gmail delegation)
# CRM_IP=127.0.0.1
# CRM_HOST=my_crm_host_name
# GOOGLE_OAUTH2_CLIENT_ID=
# GOOGLE_OAUTH2_CLIENT_SECRET=
