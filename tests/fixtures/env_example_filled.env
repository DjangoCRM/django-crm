# Filled placeholder environment derived from .env.example for integration tests.
DJANGO_SECRET_KEY=<test-secret-key-not-for-production-use>
DJANGO_DEBUG=<true-or-false>
DJANGO_ALLOWED_HOSTS=<localhost,127.0.0.1>
DJANGO_CSRF_TRUSTED_ORIGINS=<http://localhost,http://127.0.0.1>
DJANGO_DB_ENGINE=<sqlite3>
DJANGO_DB_NAME=<crm_db>
EMAIL_HOST=<smtp.example.com>
EMAIL_PORT=<587>
EMAIL_HOST_USER=<placeholder-smtp-user@example.com>
EMAIL_HOST_PASSWORD=<placeholder-mail-password>
EMAIL_USE_TLS=<true>
DEFAULT_FROM_EMAIL=<noreply@example.com>
SERVER_EMAIL=<noreply@example.com>
DJANGO_ADMINS=<Admin <admin@example.com>>
CRM_IP=<127.0.0.1>
CRM_HOST=<crm.example.com>
GOOGLE_OAUTH2_CLIENT_ID=<placeholder-oauth-client-id>
GOOGLE_OAUTH2_CLIENT_SECRET=<placeholder-oauth-client-secret>
GOOGLE_RECAPTCHA_SITE_KEY=<placeholder-recaptcha-site-key>
GOOGLE_RECAPTCHA_SECRET_KEY=<placeholder-recaptcha-secret-key>
ZADARMA_KEY=<placeholder-zadarma-key>
ZADARMA_SECRET=<placeholder-zadarma-secret>
ZADARMA_PROVIDER_ALLOWLIST=<203.0.113.10>
SECRET_CRM_PREFIX=<custom-crm-prefix/>
SECRET_ADMIN_PREFIX=<custom-admin-prefix/>
SECRET_LOGIN_PREFIX=<custom-login-prefix/>
